{
  "name": "jdr-viewer-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "IROAD JDR 블랙박스 파일 뷰어 (브라우저에서 전부 처리, 업로드 없음)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build:single": "vite build --config vite.config.single.ts",
    "make-sample": "tsx scripts/make-sample-jdr.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.20.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  }
}
